From 4ed1a6dc3b65f25f88818f76f63f940dd7fed620 Mon Sep 17 00:00:00 2001
From: Robin Watts <Robin.Watts@artifex.com>
Date: Mon, 19 Oct 2026 17:45:33 +0100
Subject: [PATCH] Bug 709849: Avoid pdf_objcmp matching across documents.

It's fine to match pdf objects that don't mention indirections
across documents. We must not match those that do as this
upsets store entries.

We only need to check indirects themselves, and dicts (that
might be streams).

Many thanks to "Carl" for the buf report, analysis, and a different
suggested fix.
---
 source/pdf/pdf-object.c | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/source/pdf/pdf-object.c b/source/pdf/pdf-object.c
index 0333c45d37..c40c717208 100644
--- a/source/pdf/pdf-object.c
+++ b/source/pdf/pdf-object.c
@@ -619,6 +619,10 @@ do_objcmp(fz_context *ctx, pdf_obj *a, pdf_obj *b, int check_streams)
 		return strcmp(NAME(a)->n, NAME(b)->n);
 
 	case PDF_INDIRECT:
+		if (REF(a)->doc < REF(b)->doc)
+			return -1;
+		else if (REF(a)->doc > REF(b)->doc)
+			return 1;
 		if (REF(a)->num == REF(b)->num)
 			return REF(a)->gen - REF(b)->gen;
 		return REF(a)->num - REF(b)->num;
@@ -632,6 +636,10 @@ do_objcmp(fz_context *ctx, pdf_obj *a, pdf_obj *b, int check_streams)
 		return 0;
 
 	case PDF_DICT:
+		if (REF(a)->doc < REF(b)->doc)
+			return -1;
+		else if (REF(a)->doc > REF(b)->doc)
+			return 1;
 		if (DICT(a)->len != DICT(b)->len)
 			return DICT(a)->len - DICT(b)->len;
 		if ((a->flags & b->flags) & PDF_FLAGS_SORTED)
