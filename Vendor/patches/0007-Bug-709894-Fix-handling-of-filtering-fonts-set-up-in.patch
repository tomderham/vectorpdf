From 97a78ae35a9d1a41bf4563c3049c5af0ebd8c6b1 Mon Sep 17 00:00:00 2001
From: Robin Watts <Robin.Watts@artifex.com>
Date: Mon, 26 Oct 2026 19:05:13 +0000
Subject: [PATCH] Bug 709894: Fix handling of filtering fonts set up in an
 ExtGState.

When interpreting a PDF, if we apply an ExtGState that has a font
definition in it, we call the op_Tf entrypoint for the processor,
giving "ExtGState" as the name of the font. This allows the standard
Tf handling to select and use the font without us duplicating all
that logic into an _op_gs_Tf method.

Unfortunately, in the case where we are filtering/writing out to
a new PDF stream, we end up with both the orginal:

  /GS1 gs

instruction, followed by:

 /ExtGState <size> Tf

As a quick workaround here, we will instead sent NULL as the name,
and use that to detect that we should not send the Tf line at all.
---
 source/pdf/pdf-interpret.c | 2 +-
 source/pdf/pdf-op-filter.c | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/source/pdf/pdf-interpret.c b/source/pdf/pdf-interpret.c
index 15af6e0e38..4d3081bf45 100644
--- a/source/pdf/pdf-interpret.c
+++ b/source/pdf/pdf-interpret.c
@@ -919,7 +919,7 @@ pdf_process_extgstate(fz_context *ctx, pdf_processor *proc, pdf_csi *csi, pdf_ob
 		else
 			font = pdf_load_hail_mary_font(ctx, csi->doc);
 		fz_try(ctx)
-			proc->op_Tf(ctx, proc, "ExtGState", font, pdf_to_real(ctx, font_size));
+			proc->op_Tf(ctx, proc, NULL, font, pdf_to_real(ctx, font_size));
 		fz_always(ctx)
 			pdf_drop_font(ctx, font);
 		fz_catch(ctx)
diff --git a/source/pdf/pdf-op-filter.c b/source/pdf/pdf-op-filter.c
index 98c3fc98c1..2c05b3fe2d 100644
--- a/source/pdf/pdf-op-filter.c
+++ b/source/pdf/pdf-op-filter.c
@@ -608,7 +608,7 @@ static void filter_flush(fz_context *ctx, pdf_sanitize_processor *p, int flush)
 				gstate->pending.text.fontname != gstate->sent.text.fontname)
 			{
 				gstate = ensure_pushed(ctx, p);
-				if (p->super.chain->op_Tf)
+				if (gstate->pending.text.fontname != NULL && p->super.chain->op_Tf)
 					p->super.chain->op_Tf(ctx, p->super.chain, fz_cstring_from_string(gstate->pending.text.fontname), gstate->pending.text.font, gstate->pending.text.size);
 			}
 			if (gstate->pending.text.render != gstate->sent.text.render)
