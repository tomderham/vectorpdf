 	size_t z = p->buffer->len;
 
 	if (p->mine->op_BI)
-		p->mine->op_BI(ctx, p->mine, image, colorspace);
+		p->mine->op_BI(ctx, p->mine, image, colorspace, cs_is_inline);
 
 	z = p->buffer->len - z;
 	p->op_usage->len[OP_BI] += z;
