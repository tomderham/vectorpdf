From e24a84b67d864b0e685bc18ea72ac3ecbe62cfe9 Mon Sep 17 00:00:00 2001
From: Robin Watts <Robin.Watts@artifex.com>
Date: Mon, 26 Oct 2026 17:05:43 +0000
Subject: [PATCH] Bug 709892: Avoid sanitization filter dropped text outside
 BT/ET.

The PDF interpreter itself implicitly starts a text object if it
finds text operators without one. Do the same in the sanitization
filter.

From a report by Zachary Travis. Many thanks!
---
 source/pdf/pdf-op-filter.c | 56 ++++++++++++++++++++++++++++++++++----
 1 file changed, 50 insertions(+), 6 deletions(-)

diff --git a/source/pdf/pdf-op-filter.c b/source/pdf/pdf-op-filter.c
index 7382011b52..98c3fc98c1 100644
--- a/source/pdf/pdf-op-filter.c
+++ b/source/pdf/pdf-op-filter.c
@@ -1935,13 +1935,8 @@ pdf_filter_Wstar(fz_context *ctx, pdf_processor *proc)
 /* text objects */
 
 static void
-pdf_filter_BT(fz_context *ctx, pdf_processor *proc)
+do_BT(fz_context *ctx, pdf_sanitize_processor *p)
 {
-	pdf_sanitize_processor *p = (pdf_sanitize_processor*)proc;
-
-	if (fz_is_empty_rect(p->gstate->clip_rect))
-		return;
-
 	p->tos.tm = fz_identity;
 	p->tos.tlm = fz_identity;
 	p->sent_tm = fz_identity;
@@ -1951,6 +1946,17 @@ pdf_filter_BT(fz_context *ctx, pdf_processor *proc)
 	p->text_removed = 0;
 }
 
+static void
+pdf_filter_BT(fz_context *ctx, pdf_processor *proc)
+{
+	pdf_sanitize_processor *p = (pdf_sanitize_processor*)proc;
+
+	if (fz_is_empty_rect(p->gstate->clip_rect))
+		return;
+
+	do_BT(ctx, p);
+}
+
 static void
 pdf_filter_ET(fz_context *ctx, pdf_processor *proc)
 {
@@ -2003,6 +2009,14 @@ pdf_filter_Q(fz_context *ctx, pdf_processor *proc)
 
 /* text state */
 
+static void
+implicit_bt(fz_context *ctx, pdf_sanitize_processor *p)
+{
+	if (!p->in_BT && !p->BT_pending)
+		do_BT(ctx, p);
+}
+
+
 static void
 pdf_filter_Tc(fz_context *ctx, pdf_processor *proc, float charspace)
 {
@@ -2011,6 +2025,8 @@ pdf_filter_Tc(fz_context *ctx, pdf_processor *proc, float charspace)
 	if (fz_is_empty_rect(p->gstate->clip_rect))
 		return;
 
+	implicit_bt(ctx, p);
+
 	filter_flush(ctx, p, FLUSH_OP);
 	p->gstate->pending.text.char_space = charspace;
 }
@@ -2023,6 +2039,8 @@ pdf_filter_Tw(fz_context *ctx, pdf_processor *proc, float wordspace)
 	if (fz_is_empty_rect(p->gstate->clip_rect))
 		return;
 
+	implicit_bt(ctx, p);
+
 	filter_flush(ctx, p, FLUSH_OP);
 	p->gstate->pending.text.word_space = wordspace;
 }
@@ -2037,6 +2055,8 @@ pdf_filter_Tz(fz_context *ctx, pdf_processor *proc, float scale)
 	if (fz_is_empty_rect(p->gstate->clip_rect))
 		return;
 
+	implicit_bt(ctx, p);
+
 	filter_flush(ctx, p, FLUSH_OP);
 	p->gstate->pending.text.scale = scale / 100;
 }
@@ -2049,6 +2069,8 @@ pdf_filter_TL(fz_context *ctx, pdf_processor *proc, float leading)
 	if (fz_is_empty_rect(p->gstate->clip_rect))
 		return;
 
+	implicit_bt(ctx, p);
+
 	filter_flush(ctx, p, FLUSH_OP);
 	p->gstate->leading = leading;
 	p->gstate->pending.text.leading = leading;
@@ -2062,6 +2084,8 @@ pdf_filter_Tf(fz_context *ctx, pdf_processor *proc, const char *name, pdf_font_d
 	if (fz_is_empty_rect(p->gstate->clip_rect))
 		return;
 
+	implicit_bt(ctx, p);
+
 	filter_flush(ctx, p, FLUSH_OP);
 	fz_drop_string(ctx, p->gstate->pending.text.fontname);
 	p->gstate->pending.text.fontname = NULL;
@@ -2079,6 +2103,8 @@ pdf_filter_Tr(fz_context *ctx, pdf_processor *proc, int render)
 	if (fz_is_empty_rect(p->gstate->clip_rect))
 		return;
 
+	implicit_bt(ctx, p);
+
 	filter_flush(ctx, p, FLUSH_OP);
 	p->gstate->pending.text.render = render;
 }
@@ -2091,6 +2117,8 @@ pdf_filter_Ts(fz_context *ctx, pdf_processor *proc, float rise)
 	if (fz_is_empty_rect(p->gstate->clip_rect))
 		return;
 
+	implicit_bt(ctx, p);
+
 	filter_flush(ctx, p, FLUSH_OP);
 	p->gstate->pending.text.rise = rise;
 }
@@ -2105,6 +2133,8 @@ pdf_filter_Td(fz_context *ctx, pdf_processor *proc, float tx, float ty)
 	if (fz_is_empty_rect(p->gstate->clip_rect))
 		return;
 
+	implicit_bt(ctx, p);
+
 	pdf_tos_translate(&p->tos, tx, ty);
 }
 
@@ -2116,6 +2146,8 @@ pdf_filter_TD(fz_context *ctx, pdf_processor *proc, float tx, float ty)
 	if (fz_is_empty_rect(p->gstate->clip_rect))
 		return;
 
+	implicit_bt(ctx, p);
+
 	p->gstate->leading = -ty;
 	pdf_filter_Td(ctx, proc, tx, ty);
 }
@@ -2128,6 +2160,8 @@ pdf_filter_Tm(fz_context *ctx, pdf_processor *proc, float a, float b, float c, f
 	if (fz_is_empty_rect(p->gstate->clip_rect))
 		return;
 
+	implicit_bt(ctx, p);
+
 	filter_flush(ctx, p, FLUSH_OP);
 	pdf_tos_set_matrix(&p->tos, a, b, c, d, e, f);
 }
@@ -2140,6 +2174,8 @@ pdf_filter_Tstar(fz_context *ctx, pdf_processor *proc)
 	if (fz_is_empty_rect(p->gstate->clip_rect))
 		return;
 
+	implicit_bt(ctx, p);
+
 	filter_flush(ctx, p, FLUSH_OP);
 	pdf_tos_newline(&p->tos, p->gstate->leading);
 }
@@ -2154,6 +2190,8 @@ pdf_filter_TJ(fz_context *ctx, pdf_processor *proc, pdf_obj *array)
 	if (fz_is_empty_rect(p->gstate->clip_rect))
 		return;
 
+	implicit_bt(ctx, p);
+
 	filter_show_text(ctx, p, array);
 }
 
@@ -2165,6 +2203,8 @@ pdf_filter_Tj(fz_context *ctx, pdf_processor *proc, char *str, size_t len)
 	if (fz_is_empty_rect(p->gstate->clip_rect))
 		return;
 
+	implicit_bt(ctx, p);
+
 	filter_show_string(ctx, p, (unsigned char *)str, len);
 }
 
@@ -2177,6 +2217,8 @@ pdf_filter_squote(fz_context *ctx, pdf_processor *proc, char *str, size_t len)
 	if (fz_is_empty_rect(p->gstate->clip_rect))
 		return;
 
+	implicit_bt(ctx, p);
+
 	pdf_tos_newline(&p->tos, p->gstate->pending.text.leading);
 	filter_show_string(ctx, p, (unsigned char *)str, len);
 }
@@ -2191,6 +2233,8 @@ pdf_filter_dquote(fz_context *ctx, pdf_processor *proc, float aw, float ac, char
 	if (fz_is_empty_rect(p->gstate->clip_rect))
 		return;
 
+	implicit_bt(ctx, p);
+
 	p->gstate->pending.text.word_space = aw;
 	p->gstate->pending.text.char_space = ac;
 	pdf_tos_newline(&p->tos, p->gstate->pending.text.leading);
