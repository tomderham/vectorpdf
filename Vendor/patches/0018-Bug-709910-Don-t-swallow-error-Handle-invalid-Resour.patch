From edd7a81ca0f724ccffc425209f9cfa4fde5fe706 Mon Sep 17 00:00:00 2001
From: Tor Andersson <tor.andersson@artifex.com>
Date: Mon, 2 Nov 2026 17:50:44 +0100
Subject: [PATCH] Bug 709910: Don't swallow error. Handle invalid Resource
 entries.

The reproducer file has a /Resource 0 entry (not a dictionary).
We failed on this, but the try/catch in pdf_bake_document silently
dropped the error instead of propagating it.

Fix both handling invalid (non-dict) /Resource entries and propagate
any errors that do occur during pdf_bake_page.
---
 source/pdf/pdf-form.c | 11 ++++++-----
 1 file changed, 6 insertions(+), 5 deletions(-)

diff --git a/source/pdf/pdf-form.c b/source/pdf/pdf-form.c
index d133b0d2c0..5b45efcdca 100644
--- a/source/pdf/pdf-form.c
+++ b/source/pdf/pdf-form.c
@@ -2451,17 +2451,17 @@ static void pdf_bake_page(fz_context *ctx, pdf_document *doc, pdf_obj *page, int
 		return;
 
 	res = pdf_dict_get(ctx, page, PDF_NAME(Resources));
-	if (!res)
+	if (!pdf_is_dict(ctx, res))
 	{
 		res = pdf_dict_get_inheritable(ctx, page, PDF_NAME(Resources));
-		if (res)
-			pdf_dict_put(ctx, page, PDF_NAME(Resources), res);
-		else
+		if (!pdf_is_dict(ctx, res))
 			res = pdf_dict_put_dict(ctx, page, PDF_NAME(Resources), 4);
+		else
+			pdf_dict_put(ctx, page, PDF_NAME(Resources), res);
 	}
 
 	res_xobj = pdf_dict_get(ctx, res, PDF_NAME(XObject));
-	if (!res_xobj)
+	if (!pdf_is_dict(ctx, res_xobj))
 		res_xobj = pdf_dict_put_dict(ctx, res, PDF_NAME(XObject), 8);
 
 	fz_try(ctx)
@@ -2597,5 +2597,6 @@ void pdf_bake_document(fz_context *ctx, pdf_document *doc, int bake_annots, int
 	fz_catch(ctx)
 	{
 		pdf_abandon_operation(ctx, doc);
+		fz_rethrow(ctx);
 	}
 }
