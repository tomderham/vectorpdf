# Copy to Scripts/release.env (untracked) and fill in. Read by Scripts/build_dmg.sh.
# Find your identity with: security find-identity -v -p codesigning
SIGNING_IDENTITY="Developer ID Application: Your Name (TEAMID)"
# Keychain profile created with: xcrun notarytool store-credentials "<profile>"
NOTARY_PROFILE="notary-profile"
# Optional: Developer ID provisioning profile for the App ID, with the Private Cloud Compute and/or
# iCloud (key-value storage) capabilities. See the comment at the top of Scripts/build_dmg.sh.
# PROVISIONING_PROFILE="/path/to/VectorPDF_Developer_ID.provisionprofile"
